# ==============================================================================
# OptiTrain.ai / Edge AI - Production & Development Environment Configuration
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV="production"

# Public URL of the deployed application (e.g., https://optitrain.yourclinic.com or Vercel URL)
NEXT_PUBLIC_APP_URL="https://optitrain.yourclinic.com"

# PostgreSQL connection string (supports Neon, Supabase, AWS RDS, Railway, local)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require&schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/optitrain_db?schema=public"

# Cryptographic signing secret for JOSE HS256 authentication JWT sessions
# Generate with: openssl rand -base64 32 (minimum 32 characters required)
JWT_SECRET="replace_with_a_secure_random_string_at_least_32_chars_long"

# Google Gemini AI API Configuration
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Gemini model identifier (recommended: gemini-2.5-flash or gemini-1.5-flash or gemini-2.5-flash-lite)
GEMINI_MODEL="gemini-2.5-flash"

# Initial Practice Owner Provisioning (Used once by `npm run seed:owner`)
# Once provisioned, the safety lock permanently disables re-bootstrapping.
INITIAL_OWNER_EMAIL="owner@apex-optics.com"
INITIAL_OWNER_PASSWORD="ReplaceWithStrongPassword123!"
INITIAL_OWNER_NAME="Dr. Sarah Lin (Practice Owner)"
